<?xml version="1.0" encoding="utf-8"?>
<!--
  Neolink.NET Desktop installer.

  Three things this has to get right, because they are what people actually hit:

  1. Installing over an existing copy REPLACES it, including a reinstall of the
     same version number (AllowSameVersionUpgrades) - "download the new build and
     run it" must never end with two entries in Add/Remove Programs.
  2. The app is a tray app that starts with Windows, so it is almost always
     RUNNING during an upgrade. It is asked to shut down politely first and
     terminated if it will not, before any file is touched.
  3. The Start Menu shortcut carries the AppUserModelID. That shortcut IS the
     app's identity to the Action Center; without it Windows will not accept its
     toasts, and notifications quietly downgrade to tray balloons.

  Build it with installer/build-msi.ps1 - that script publishes the app and
  passes the version and publish directory in.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define AppName = "Neolink.NET Desktop" ?>
  <?define Manufacturer = "Oluwabori Olaleye" ?>
  <?define ExeName = "Neolink.Desktop.exe" ?>
  <!-- Must match AppShortcut.AppUserModelId in the app, or the shortcut the
       installer writes registers a DIFFERENT app and toasts stop working. -->
  <?define Aumid = "OluwaboriOlaleye.NeolinkNET.Desktop" ?>

  <Package Name="$(AppName)"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="3F8DC7D6-953C-4057-824F-71B797DE5C98"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="$(AppName) $(Version)" Manufacturer="$(Manufacturer)" />

    <!-- Any earlier version is removed first; the same version is treated as an
         upgrade too, so re-running the installer refreshes a broken install
         instead of refusing. Scheduled after InstallInitialize so the old files
         only disappear once the new ones are known good. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of $(AppName) is already installed. Uninstall it first if you really want to go back to $(Version)." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      Closing the running app is a two-layer job, and the layers run at different
      times.

      Restart Manager (left ENABLED - not disabling it is the point) detects the
      running shell during InstallValidate, which is BEFORE RemoveExistingProducts
      removes the old version, and asks it to shut down the way Windows does at
      logoff. The shell answers that properly: OnFormClosing only swallows a
      CloseReason.UserClosing, so a session-end request really exits while the
      tray's own X does not.

      util:CloseApplication below is the backstop, running just before InstallFiles
      for anything Restart Manager could not reach - a hung copy, or one whose
      window never came up. WM_CLOSE is deliberately NOT sent: for this app that
      means "hide to the tray" and would achieve nothing. The end-session message
      exits it cleanly; TerminateProcess ends it after Timeout if it will not go.
    -->
    <util:CloseApplication Id="CloseNeolinkDesktop"
                           Target="$(ExeName)"
                           Description="$(AppName) is running and will be closed to complete the installation."
                           EndSessionMessage="yes"
                           ElevatedEndSessionMessage="yes"
                           TerminateProcess="0"
                           RebootPrompt="no"
                           Timeout="10" />

    <!-- Once the shell is closed nothing here is in use, so a reboot is never the
         right answer; say so rather than letting Windows guess. -->
    <Property Id="REBOOT" Value="ReallySuppress" />

    <Property Id="ARPPRODUCTICON" Value="NeolinkIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/borexola/neolink.net" />
    <!-- Add/Remove Programs shows a blank install location without this, because
         INSTALLFOLDER is only known once the user has been through the dialog. -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="both" />
    <!-- ARPNOMODIFY comes from WixUI_InstallDir; there is nothing to modify here. -->
    <Icon Id="NeolinkIcon" SourceFile="$(PublishDir)\neolink.ico" />

    <!-- Two features, and the choice is the install's whole story:
           - the desktop app alone, pointed at a server that already exists
             (Docker, the Home Assistant add-on, another PC), or
           - that PLUS the server itself as a Windows service - a standalone
             install with nothing else to run.
         The server feature defaults OFF (Level 2 > INSTALLLEVEL 1): today's
         typical download pairs the app with an existing add-on, and a surprise
         service that starts recording to ProgramData must be chosen, not
         defaulted into. The feature tree is where it gets chosen; upgrades keep
         whatever was chosen last time (MajorUpgrade migrates feature states). -->
    <Feature Id="Main" Title="Desktop app" Level="1" AllowAdvertise="no" AllowAbsent="no"
             Description="The Neolink.NET viewer: your camera wall in its own window, alerts in the Action Center, starts with Windows.">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppShortcuts" />
    </Feature>
    <Feature Id="LocalServer" Title="Local server (Windows service)" Level="2" AllowAdvertise="no"
             Description="Run the full Neolink.NET server on this PC as a Windows service - no Docker or Home Assistant needed. It records and serves your cameras even when nobody is signed in; the desktop app connects to it at http://localhost:8655.">
      <ComponentGroupRef Id="ServerFiles" />
      <ComponentRef Id="ServerService" />
      <ComponentRef Id="NeolinkDataDir" />
      <ComponentRef Id="NeolinkLogsDir" />
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(AppName)">
        <Directory Id="ServerFolder" Name="Server" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <!-- The service's world lives in ProgramData, never Program Files: the
         config it writes on first start, the accounts and UI state beside it,
         recordings under .\recordings, logs under .\logs. Uninstall leaves the
         directory behind on purpose - configs and footage are the user's, and a
         reinstall picks them straight back up. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="NeolinkDataFolder" Name="Neolink.NET">
        <Directory Id="NeolinkLogsFolder" Name="logs" />
      </Directory>
    </StandardDirectory>

    <!-- Every file the publish produced, laid down as-is. A self-contained build
         means the .NET runtime rides along and no prerequisite has to be chased. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <!-- The server: a single self-contained exe plus its web assets, in a Server
         subfolder so the two programs never shadow each other's files. The exe is
         excluded from the harvest because the service registration must live in
         the component that owns it. -->
    <ComponentGroup Id="ServerFiles" Directory="ServerFolder">
      <Files Include="$(ServerPublishDir)\**">
        <Exclude Files="$(ServerPublishDir)\neolink.net.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="ServerService" Directory="ServerFolder" Guid="7A2B04E3-9C61-4D5B-8E0F-2D64C1A7B9D2">
      <File Id="NeolinkServerExe" Source="$(ServerPublishDir)\neolink.net.exe" KeyPath="yes">
        <!-- One program-scoped rule instead of per-port ones: it covers the web
             UI (8655), RTSP (8654) AND the UDP dialects battery cameras answer
             on, and it keeps meaning that after someone changes a port in the
             config. localSubnet: the LAN is the audience; the internet is not. -->
        <fw:FirewallException Id="NeolinkServerFirewall" Name="Neolink.NET Server"
                              Scope="localSubnet" Profile="all" />
      </File>
      <!-- LocalSystem rather than a low-privilege account, deliberately: the UI
           lets people point recordings at any disk they own (D:\, a NAS letter),
           and a service account that needs hand-ACLing for every such folder
           turns a settings change into a support case. -->
      <ServiceInstall Id="NeolinkService"
                      Name="Neolink.NET"
                      DisplayName="Neolink.NET Server"
                      Description="Reolink camera bridge - RTSP restreaming, recording, and the web UI at http://localhost:8655."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Arguments="--service --config &quot;[NeolinkDataFolder]config.json&quot; --log &quot;[NeolinkLogsFolder]neolink.log&quot;"
                      Vital="yes" />
      <!-- Start on install so the finish dialog's "start now" opens a UI that is
           already there; Stop on both so an upgrade can replace the exe. -->
      <ServiceControl Id="NeolinkServiceControl" Name="Neolink.NET"
                      Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      <!-- Recovery: restart after any failure. This is BOTH crash resilience and
           the web UI's Restart button — a service cannot restart itself, so a
           UI-requested restart exits without reporting SERVICE_STOPPED and these
           actions bring it back up. -->
      <util:ServiceConfig ServiceName="Neolink.NET"
                          FirstFailureActionType="restart"
                          SecondFailureActionType="restart"
                          ThirdFailureActionType="restart"
                          RestartServiceDelayInSeconds="2"
                          ResetPeriodInDays="1" />
    </Component>

    <Component Id="NeolinkDataDir" Directory="NeolinkDataFolder" Guid="5E91D7C4-63BA-4F2E-9A07-B81D3C5F6A18">
      <CreateFolder />
      <!-- The desktop app's tell that localhost:8655 is a Neolink server: its
           connect dialog prefills the address when this is present. Removed with
           the feature, so an uninstalled server stops being suggested. -->
      <RegistryValue Root="HKLM" Key="SOFTWARE\Neolink.NET"
                     Name="LocalServer" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="NeolinkLogsDir" Directory="NeolinkLogsFolder" Guid="0C4F8A61-2E7D-4B93-B5C2-9F1E6D0A3487">
      <CreateFolder />
    </Component>

    <ComponentGroup Id="AppShortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="424CC58D-1869-4051-A945-D10CEB00083D">
        <Shortcut Id="StartMenuLink"
                  Name="$(AppName)"
                  Description="Live view, recordings and alerts for your Reolink cameras"
                  Target="[INSTALLFOLDER]$(ExeName)"
                  WorkingDirectory="INSTALLFOLDER">
          <!-- The whole reason this shortcut is required: it is what lets an
               unpackaged app raise Windows toasts under a stable identity. -->
          <ShortcutProperty Key="System.AppUserModel.ID" Value="$(Aumid)" />
        </Shortcut>
        <RemoveFolder Id="RemoveStartMenuFolder" Directory="ProgramMenuFolder" On="uninstall" />
        <!-- A per-machine component needs a per-user anchor for its shortcut. -->
        <RegistryValue Root="HKCU" Key="Software\$(Manufacturer)\$(AppName)"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- The autostart entry the app writes lives under HKCU and belongs to
         whoever turned it on, so the installer touches it in NO direction. It
         must not create it, and it must not remove it either: MSI's
         RemoveRegistryValue fires when its component INSTALLS, which would wipe
         the user's autostart on every upgrade. After an uninstall the entry may
         linger pointing at a removed file - Windows skips such entries silently,
         and a reinstall's first launch rewrites it (Autostart.RepairIfStale). -->

    <!-- Offer to start it when the install finishes: this app's job begins the
         moment it is running, not the next time someone remembers it exists. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start $(AppName) now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- Resolved at run time, not build time: INSTALLFOLDER is whatever the user
         chose on the install-directory page. -->
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]$(ExeName)"
                 After="CostFinalize" Sequence="both" />
    <CustomAction Id="LaunchApp" DllEntry="WixShellExec" Impersonate="yes"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" Return="ignore" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <!-- The local-server choice is one question, so it gets one page with one
         checkbox — not the feature tree, whose "Will be installed on local hard
         drive" dropdowns read like a filesystem exam to the very people the
         standalone option is for. The page slots between the licence and the
         folder; Next translates the box into MSI feature states. -->
    <!-- Preselect on upgrade: the marker the server feature writes is also how
         this installer remembers the last answer, so upgrading a standalone
         install arrives with the box already ticked. -->
    <Property Id="INSTALL_LOCAL_SERVER">
      <RegistrySearch Id="ExistingLocalServer" Root="HKLM" Key="SOFTWARE\Neolink.NET"
                      Name="LocalServer" Type="raw" Bitness="always64" />
    </Property>
    <UI>
      <Dialog Id="LocalServerDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="330" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Choose what this PC does" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="Just the viewer — or the whole system." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="ViewerText" Type="Text" X="20" Y="58" Width="330" Height="28" NoPrefix="yes"
                 Text="Out of the box, this installs the viewer: your cameras in a window, connected to a Neolink.NET server you already have (the Home Assistant add-on, Docker, or another PC)." />
        <Control Id="ServerCheck" Type="CheckBox" X="20" Y="96" Width="330" Height="17"
                 Property="INSTALL_LOCAL_SERVER" CheckBoxValue="1"
                 Text="&amp;Run everything on this PC — install the server too" />
        <Control Id="ServerText" Type="Text" X="33" Y="116" Width="317" Height="44" NoPrefix="yes"
                 Text="No server yet? Tick this and this PC becomes the whole system: the server runs in the background, starts with Windows, and records and serves your cameras around the clock — no Docker, no Home Assistant. Phones and other PCs on your network can connect to it too." />
        <Control Id="ChangeText" Type="Text" X="33" Y="164" Width="317" Height="17" NoPrefix="yes"
                 Text="Not sure? Leave it unticked — running this installer again can add it later." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="&amp;Next">
          <Publish Event="AddLocal" Value="LocalServer" Condition="INSTALL_LOCAL_SERVER" />
          <Publish Event="Remove" Value="LocalServer" Condition="NOT INSTALL_LOCAL_SERVER" />
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <!-- Re-route the stock InstallDir flow through the new page. Order beats
           the built-in publishes; for NewDialog the last one that fires wins. -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="LocalServerDlg"
               Condition="LicenseAccepted = &quot;1&quot;" Order="99" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LocalServerDlg"
               Order="99" />
    </UI>
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />

  </Package>
</Wix>
