{
  // Neolink.NET configuration. Copy to config.json and edit; comments and trailing commas are fine.
  // Most of this can also be set from the web UI (Server settings). Every option: README → Configuration.

  "bind": "0.0.0.0",     // "127.0.0.1" = this computer only
  "bind_port": 8654,     // RTSP (VLC, Frigate, Home Assistant, ...)
  "web_port": 8655,      // web UI and API; 0 = off

  "ui": {
    // Where accounts and layouts are kept (default: this file's folder). Use a persistent volume.
    // "state_dir": "/config",

    // Locked out? true lets the login screen set a new admin password. Set back to false after.
    "reset_admin_password": false
  },

  // Optional: record detection events (and 24/7 footage, switched on per camera in the web UI).
  // "recording": {
  //   "path": "/recordings",       // in Docker, a mounted volume
  //   "retention_days": 7          // 0 = keep forever
  // },

  // Optional: Home Assistant over MQTT (auto-discovery).
  // "mqtt": {
  //   "broker": "192.168.1.10",
  //   "username": "neolink",
  //   "password": "CHANGE-ME"
  // },

  // Optional: RTSP logins, e.g. rtsp://me:mepass@<host>:8654/driveway. Empty = open access.
  "users": [
    // { "name": "me", "pass": "mepass" }
  ],

  "cameras": [
    {
      "name": "driveway",              // used in the RTSP URL and the web UI
      "username": "admin",             // same login as the Reolink app
      "password": "CHANGE-ME",
      "address": "192.168.1.187",      // IP or hostname; port 9000 unless given
      "stream": "both",                // mainStream, subStream, both or all

      // "http_address": "192.168.1.187",   // camera's web interface: lets the UI change stream settings
      // "channel_id": 1,                   // behind a Reolink NVR, or a dual-lens camera's second lens
      // "permitted_users": [ "me" ],       // only these RTSP users may watch
      // "always_on": true,                 // battery cameras: stay awake 24/7 (see docs/battery-cameras.md)

      // PTZ buttons in Frigate (port 8656, onvif.profile = this camera's name):
      // "ptz_share": true,
      // Click-to-move and autotracking in Frigate (experimental, see docs/autotracking.md). Reolink E1 Pro values:
      // "ptz_fov_h": 87.5,                 // horizontal lens angle, from the spec sheet
      // "ptz_pan_rate": 59.2,              // °/s panning: 355° in 6 s
      // "ptz_tilt_rate": 25,               // °/s tilting: 50° in 2 s
    },

    // Non-Reolink camera: RTSP URLs with the login inside. Streams and records; no Reolink extras.
    // {
    //   "name": "garage",
    //   "rtsp_main": "rtsp://user:pass@192.168.1.60:554/stream1",
    //   "rtsp_sub": "rtsp://user:pass@192.168.1.60:554/stream2"
    // },
  ]
}
