@using Neolink.WebClient.Localization
@inject Translator T
@inject HttpClient Http

<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
    </Found>
</Router>

@code {
    /// <summary>The language the host page resolved (cookie, else the server
    /// default). Passing it as a parameter of the interactive root is what carries
    /// it across the static-render boundary, so the prerendered HTML and the live
    /// circuit agree from the first frame instead of flashing English.</summary>
    [Parameter] public string? Language { get; set; }

    /// <summary>The browser's address as the host page saw it; forwarded on this
    /// circuit's loopback API calls so setup and sign-in checks see the real caller.</summary>
    [Parameter] public string? ClientAddress { get; set; }

    protected override void OnParametersSet()
    {
        T.Initialize(Language);
        if (ClientAddress != null && !Http.DefaultRequestHeaders.Contains("X-Forwarded-For"))
            Http.DefaultRequestHeaders.TryAddWithoutValidation("X-Forwarded-For", ClientAddress);
    }
}
